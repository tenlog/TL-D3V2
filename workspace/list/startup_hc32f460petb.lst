  405 00000000         Reset_Handler
                               PROC
  406 00000000                 EXPORT           Reset_Handler             [WEAK
]
  407 00000000                 IMPORT           SystemInit
  408 00000000                 IMPORT           __main
  409 00000000         
  410 00000000         ;reset NVIC if in rom debug
  411 00000000 F04F 5000       LDR              R0, =0x20000000
  412 00000004 F04F 0200       LDR              R2, =0x0
  413 00000008 2100            MOVS             R1, #0      ; for warning,
  414 0000000A A100            ADD              R1, PC,#0   ; for A1609W,
  415 0000000C 4281            CMP              R1, R0
  416 0000000E D900            BLS              RAMCODE
  417 00000010         
  418 00000010         ; ram code base address.
  419 00000010 4402            ADD              R2, R0,R2
  420 00000012         RAMCODE
  421 00000012         ; reset Vector table address.
  422 00000012 4808            LDR              R0, =0xE000ED08
  423 00000014 6002            STR              R2, [R0]
  424 00000016         
  425 00000016 4808            LDR              R0, =SystemInit
  426 00000018 4780            BLX              R0
  427 0000001A 4808            LDR              R0, =__main
  428 0000001C 4700            BX               R0
  429 0000001E                 ENDP
